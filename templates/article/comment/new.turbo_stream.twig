<turbo-stream action="append" target="comments-list">
    <template>
        {% include 'article/comment/_comment.html.twig' with {'comment': comment, 'user': user} %}
    </template>
</turbo-stream>

<turbo-stream action="update" target="comment-count">
    <template>{{ comment.article.comments|length }}</template>
</turbo-stream>

<turbo-stream action="replace" target="new_comment">
    <template>
        {% include 'article/comment/_new_form.html.twig' with {
            'article': comment.article,
            'form': form
        } %}
    </template>
</turbo-stream>
