<turbo-frame id="articles-page-{{ page }}">
    <div class="container mx-auto px-4 -mt-10 pb-20">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {% for article in articles %}
                <div class="card bg-base-100 shadow-xl hover:shadow-2xl transition-all duration-300 hover:-translate-y-2 border border-base-300 group">
                    <figure class="relative h-64 bg-base-300 overflow-hidden">
                        {% if article.pictureName %}
                            <img src="{{ asset('uploads/pictures/articles/' ~ article.pictureName) }}" alt="{{ article.title }}" class="object-cover h-full w-full group-hover:scale-110 transition-transform duration-500" />
                        {% else %}
                            <div class="flex items-center justify-center w-full h-full opacity-20 bg-base-300">
                                <i class="fas fa-image text-6xl"></i>
                            </div>
                        {% endif %}
                        <div class="absolute top-4 right-4">
                            <div class="badge badge-primary font-bold shadow-lg py-3 px-4">{{ article.publishAt|date('d M Y') }}</div>
                        </div>
                    </figure>

                    <div class="card-body">
                        <div class="flex items-center gap-4 text-xs opacity-50 mb-2 font-bold uppercase tracking-widest">
                            <span class="flex items-center gap-1"><i class="fas fa-user text-primary"></i> {{ article.author.username }}</span>
                            <span class="flex items-center gap-1"><i class="fas fa-comments text-primary"></i> {{ article.comments|length }}</span>
                        </div>

                        <h2 class="card-title text-2xl group-hover:text-primary transition-colors line-clamp-2">
                            {{ article.title }}
                        </h2>

                        <p class="text-base-content/70 line-clamp-3 text-sm italic my-3">
                            "{{ article.description }}"
                        </p>

                        <div class="card-actions justify-between items-center mt-4 pt-4 border-t border-base-200">
                            <div class="flex items-center gap-2 text-xs opacity-50">
                                <i class="fas fa-eye"></i> {{ article.see }} vues
                            </div>
                            <a href="{{ path('article_show', {'slug': article.slug}) }}" data-turbo-frame="_top" class="btn btn-primary btn-sm rounded-full px-6">
                                Lire la suite
                                <i class="fas fa-arrow-right ml-1 text-[10px]"></i>
                            </a>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-span-full py-20 bg-base-100 rounded-3xl shadow-inner border-2 border-dashed border-base-300 text-center">
                    <i class="fas fa-search text-6xl opacity-10 mb-6"></i>
                    <p class="text-xl opacity-50 italic">Aucun article n'a été publié pour le moment.</p>
                </div>
            {% endfor %}
        </div>
    </div>

    {% if hasNextPage %}
        <div class="flex justify-center mt-16">
            <a href="{{ path('article_index', {'page': page + 1}) }}"
               data-turbo-frame="articles-page-{{ page + 1 }}"
               onclick="this.closest('div').style.display='none'"
               class="btn btn-outline btn-primary px-10 rounded-full shadow-lg hover:shadow-primary/20">
                Découvrir plus d'articles
            </a>
        </div>
        <turbo-frame id="articles-page-{{ page + 1 }}"></turbo-frame>
    {% endif %}
</turbo-frame>
