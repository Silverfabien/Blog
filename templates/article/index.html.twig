{% extends 'base.html.twig' %}

{% block title %}Bibliothèque d'articles - BlogIA{% endblock %}

{% block body %}
    <main class="min-h-screen bg-base-200">
        <div class="bg-linear-to-br from-primary to-secondary pt-32 pb-20 px-4 text-center text-primary-content">
            <h1 class="text-4xl md:text-6xl font-extrabold mb-4 drop-shadow-lg">Bibliothèque d'articles</h1>
            <p class="text-lg md:text-xl opacity-90 max-w-2xl mx-auto font-light">
                Découvrez le savoir généré par l'intelligence artificielle.
            </p>
        </div>

        <div class="container mx-auto px-4 -mt-10 pb-20">
            <div id="articles-list-container">
                {% include 'article/_articles_list.html.twig' with {
                    'articles': articles,
                    'page': 1,
                    'hasNextPage': hasNextPage
                } %}
            </div>
        </div>
    </main>
{% endblock %}
