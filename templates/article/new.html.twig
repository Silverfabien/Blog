{% extends 'base.html.twig' %}

{% form_theme form _self %}

{% block form_row %}{{ form_widget(form) }}{% endblock %}

{% block title %}Nouvel Article - BlogIA{% endblock %}

{% block body %}
    <main class="min-h-screen bg-base-200">
        <div class="bg-linear-to-br from-primary to-secondary pt-32 pb-24 px-4 text-center text-primary-content">
            <h1 class="text-4xl md:text-5xl font-extrabold mb-4 drop-shadow-lg">Rédiger un nouvel article</h1>
            <p class="text-lg opacity-90 max-w-xl mx-auto font-light">
                Partagez vos connaissances et vos découvertes avec la communauté.
            </p>
        </div>

        <div class="container mx-auto px-4 -mt-12 pb-20 relative z-10">
            <div class="max-w-4xl mx-auto">
                <div class="card bg-base-100 shadow-2xl border border-base-300">
                    <div class="card-body p-8 md:p-12">

                        {{ form_start(form, {'attr': {'class': 'space-y-8'}}) }}

                        <div class="flex flex-col gap-2">
                            <label class="font-bold opacity-70 text-sm uppercase tracking-wider ml-1">Titre de l'article</label>
                            {{ form_widget(form.title, {'attr': {'class': 'input input-bordered input-lg focus:input-primary bg-base-100 w-full font-bold', 'placeholder': 'Un titre percutant...'}}) }}
                            {{ form_errors(form.title) }}
                        </div>

                        <div class="flex flex-col gap-2 p-6 bg-base-200 rounded-2xl border-2 border-dashed border-base-300 group hover:border-primary transition-colors">
                            <label class="font-bold opacity-70 text-sm uppercase tracking-wider flex items-center gap-2">
                                <i class="fas fa-image text-primary"></i> Image de couverture
                            </label>
                            <div class="mt-2">
                                {{ form_widget(form.pictureFile, {'attr': {'class': 'file-input file-input-bordered file-input-primary w-full'}}) }}
                            </div>
                            <p class="text-[10px] opacity-50 italic mt-1">Format recommandé : 1200x600px (JPG, PNG, WEBP)</p>
                        </div>

                        <div class="flex flex-col gap-2">
                            <label class="font-bold opacity-70 text-sm uppercase tracking-wider ml-1">Description courte (Accroche)</label>
                            {{ form_widget(form.description, {'attr': {'class': 'textarea textarea-bordered focus:textarea-primary bg-base-100 w-full h-24 italic', 'placeholder': 'Résumez votre article en quelques lignes pour donner envie de lire...'}}) }}
                            {{ form_errors(form.description) }}
                        </div>

                        <div class="flex flex-col gap-2">
                            <label class="font-bold opacity-70 text-sm uppercase tracking-wider ml-1">
                                Contenu de l'article
                            </label>

                            {# Toolbar #}
                            <div class="flex flex-wrap items-center gap-1 p-2 bg-base-100/90 backdrop-blur border border-base-300 rounded-xl shadow-sm sticky top-4 z-20" id="editor-toolbar">
                                <div class="editor-group">
                                    <div class="relative inline-block">
                                        <button id="heading-btn" type="button" class="btn btn-ghost btn-sm"><i class="fas fa-heading"></i><i class="fas fa-chevron-down text-xs opacity-50"></i></button>
                                        <ul id="heading-menu" class="absolute hidden mt-2 min-w-35 bg-base-100 border border-base-300 rounded-xl shadow-lg p-1 z-30">
                                            <li><button type="button" data-level="1" class="flex items-center gap-2 w-full px-3 py-2 rounded-lg text-sm hover:bg-primary/10 hover:text-primary transition">H1</button></li>
                                            <li><button type="button" data-level="2" class="flex items-center gap-2 w-full px-3 py-2 rounded-lg text-sm hover:bg-primary/10 hover:text-primary transition">H2</button></li>
                                            <li><button type="button" data-level="3" class="flex items-center gap-2 w-full px-3 py-2 rounded-lg text-sm hover:bg-primary/10 hover:text-primary transition">H3</button></li>
                                            <li><button type="button" data-level="4" class="flex items-center gap-2 w-full px-3 py-2 rounded-lg text-sm hover:bg-primary/10 hover:text-primary transition">H4</button></li>
                                        </ul>
                                    </div>
                                    <div class="relative inline-block">
                                        <button id="list-btn" type="button" class="btn btn-ghost btn-sm"><i class="fas fa-list"></i><i class="fas fa-chevron-down text-xs opacity-50"></i></button>
                                        <ul id="list-menu" class="absolute hidden mt-2 min-w-35 bg-base-100 border border-base-300 rounded-xl shadow-lg p-1 z-30">
                                            <li>
                                                <button type="button" data-type="bullet" class="flex items-center gap-2 w-full px-3 py-2 rounded-lg text-sm hover:bg-primary/10 hover:text-primary transition">
                                                    <i class="fas fa-list-dots"></i>
                                                </button>
                                            </li>
                                            <li>
                                                <button type="button" data-type="ordered" class="flex items-center gap-2 w-full px-3 py-2 rounded-lg text-sm hover:bg-primary/10 hover:text-primary transition">
                                                    <i class="fas fa-list-numeric"></i>
                                                </button>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                                <div class="tiptap-separator"></div>
                                <div class="editor-group">
                                    <button type="button" data-action="bold" class="btn btn-ghost btn-sm">
                                        <i class="fas fa-bold"></i>
                                    </button>
                                    <button type="button" data-action="italic" class="btn btn-ghost btn-sm">
                                        <i class="fas fa-italic"></i>
                                    </button>
                                    <button type="button" data-action="underline" class="btn btn-ghost btn-sm">
                                        <i class="fas fa-underline"></i>
                                    </button>
                                    <button type="button" data-action="strike" class="btn btn-ghost btn-sm">
                                        <i class="fas fa-strikethrough"></i>
                                    </button>
                                    <button type="button" data-action="link" class="btn btn-ghost btn-sm">
                                        <i class="fas fa-link"></i>
                                    </button>
                                </div>
                                <div class="tiptap-separator"></div>
                                <div class="editor-group">
                                    <button type="button" data-action="alignLeft" class="btn btn-ghost btn-sm">
                                        <i class="fas fa-align-left"></i>
                                    </button>
                                    <button type="button" data-action="alignCenter" class="btn btn-ghost btn-sm">
                                        <i class="fas fa-align-center"></i>
                                    </button>
                                    <button type="button" data-action="alignRight" class="btn btn-ghost btn-sm">
                                        <i class="fas fa-align-right"></i>
                                    </button>
                                    <button type="button" data-action="alignJustify" class="btn btn-ghost btn-sm">
                                        <i class="fas fa-align-justify"></i>
                                    </button>
                                </div>
                                <div class="tiptap-separator"></div>
                                <div class="editor-group">
                                    <button type="button" data-action="codeBlock" class="btn btn-ghost btn-sm">
                                        <i class="fas fa-code"></i>
                                    </button>
                                    <button type="button" data-action="blockquote" class="btn btn-ghost btn-sm">
                                        <i class="fas fa-quote-left"></i>
                                    </button>
                                    <button type="button" data-action="horizontalRule" class="btn btn-ghost btn-sm">
                                        <i class="fas fa-minus"></i>
                                    </button>
                                </div>
                                <div class="tiptap-separator"></div>
                                <div class="editor-group">
                                    <button type="button" data-action="image" class="btn btn-ghost btn-sm">
                                        <i class="fas fa-image"></i>
                                    </button>
                                    <label for="color-picker"></label><input type="color" id="color-picker" class="ml-2 h-8 w-8 cursor-pointer">
                                </div>
                            </div>

                            {# Zone Tiptap #}
                            <div
                                id="editor"
                                class="bg-base-100 border border-base-300 rounded-2xl p-6 min-h-100 focus-within:ring-2 focus-within:ring-primary/30 transition"
                            ></div>

                            {# Textarea Symfony caché #}
                            {{ form_widget(form.content, {
                                attr: {
                                    style: 'display:none',
                                    'data-tiptap-textarea': true
                                }
                            }) }}

                            {{ form_errors(form.content) }}
                        </div>

                        <div class="flex items-center justify-between p-6 bg-base-200 rounded-2xl shadow-inner">
                            <div class="flex flex-col">
                                <span class="font-bold text-base-content">Rendre l'article public ?</span>
                                <span class="text-xs opacity-50">S'il est décoché, il sera enregistré en tant que brouillon.</span>
                            </div>
                            <div class="form-control">
                                {{ form_widget(form.publish, {'attr': {'class': 'toggle toggle-primary toggle-lg'}}) }}
                            </div>
                        </div>

                        <div class="flex flex-col md:flex-row items-center justify-between gap-4 border-t border-base-200 pt-8 mt-10">
                            <a href="{{ path('article_index') }}" class="btn btn-ghost gap-2 order-2 md:order-1">
                                <i class="fas fa-times text-xs"></i>
                                Annuler
                            </a>
                            <button type="submit" class="btn btn-primary btn-wide shadow-xl shadow-primary/20 order-1 md:order-2">
                                <i class="fas fa-paper-plane mr-2"></i>
                                Enregistrer l'article
                            </button>
                        </div>

                        {{ form_end(form) }}

                    </div>
                </div>
            </div>
        </div>
    </main>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ vite_entry_script_tags('article_editor') }}
{% endblock %}
