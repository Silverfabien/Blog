{% extends 'base.html.twig' %}

{% form_theme userForm _self %}
{% form_theme resetPasswordForm _self %}

{% block form_row %}{{ form_widget(form) }}{% endblock %}

{% block title %}Mon Compte - BlogIA{% endblock %}

{% block body %}
    <main class="min-h-screen bg-base-200">
        <div class="bg-linear-to-br from-primary to-secondary pt-32 pb-24 px-4 text-center text-primary-content">
            <h1 class="text-4xl md:text-5xl font-extrabold mb-4 drop-shadow-lg">Espace Personnel</h1>
            <p class="text-lg opacity-90 max-w-xl mx-auto font-light">Gérez vos informations et vos paramètres de sécurité.</p>
        </div>

        <div class="container mx-auto px-4 -mt-12 pb-20 relative z-10">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
                    <aside class="lg:col-span-4">
                        <turbo-frame id="account-profil">
                            {% include 'security/_account_profil.html.twig' with { user: user } %}
                        </turbo-frame>
                    </aside>

                <div class="lg:col-span-8 space-y-8" id="">
                    <div class="card bg-base-100 shadow-xl border border-base-300">
                        <div class="card-body p-8">
                            <h3 class="text-xl font-bold mb-8 flex items-center gap-2 text-primary">
                                <i class="fas fa-id-card"></i> Informations du profil
                            </h3>

                            {{ form_start(userForm, {'attr': {'id': 'user-edit', 'class': 'grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-6'}}) }}
                            <div class="flex flex-col gap-2">
                                <label class="font-bold opacity-70 text-xs uppercase ml-1">Nom d'utilisateur</label>
                                {{ form_widget(userForm.username, {'attr': {'class': 'input input-bordered focus:input-primary bg-base-100 w-full'}}) }}
                            </div>
                            <div class="flex flex-col gap-2">
                                <label class="font-bold opacity-70 text-xs uppercase ml-1">Email</label>
                                {{ form_widget(userForm.email, {'attr': {'class': 'input input-bordered focus:input-primary bg-base-100 w-full'}}) }}
                            </div>
                            <div class="">
                                <label class="font-bold opacity-70 text-xs uppercase ml-1">
                                    Photo de profil
                                </label>

                                {{ form_widget(userForm.picture, {
                                    'attr': {
                                        'class': 'file-input file-input-bordered w-full focus:file-input-secondary'
                                    }
                                }) }}

                                <span class="text-xs opacity-50 italic ml-1">
                                    JPG, PNG ou WEBP – 2 Mo max
                                </span>
                            </div>

                            <div class="col-span-full mt-4 flex items-center justify-between border-t border-base-200 pt-6">
                                <div id="result" class="text-sm font-bold italic"></div>
                                <button type="submit" class="btn btn-primary px-10 shadow-lg">Enregistrer</button>
                            </div>
                            {{ form_end(userForm) }}
                        </div>
                    </div>

                    <div class="card bg-base-100 shadow-xl border border-base-300">
                        <div class="card-body p-8">
                            <h3 class="text-xl font-bold mb-8 flex items-center gap-2 text-primary">
                                <i class="fas fa-pencil"></i> Votre Signature
                            </h3>

                            {{ form_start(signatureForm, {'attr': {'class': 'grid grid-cols-1 gap-x-6 gap-y-6'}}) }}
                            <div class="flex flex-col gap-2">
                                <label class="font-bold opacity-70 text-xs uppercase ml-1">Signature</label>
                                {{ form_widget(signatureForm.signature, {'attr': {'class': 'input input-bordered focus:input-primary bg-base-100 w-full'}}) }}
                            </div>

                            <div class="col-span-full mt-4 flex items-center justify-between border-t border-base-200 pt-6">
                                <div id="result" class="text-sm font-bold italic"></div>
                                <button type="submit" class="btn btn-primary px-10 shadow-lg">Enregistrer</button>
                            </div>
                            {{ form_end(signatureForm) }}
                        </div>
                    </div>

                    <div class="card bg-base-100 shadow-xl border border-base-300">
                        <div class="card-body p-8">
                            <h3 class="text-xl font-bold mb-8 flex items-center gap-2 text-secondary">
                                <i class="fas fa-shield-alt"></i> Sécurité
                            </h3>

                            {{ form_start(resetPasswordForm, {'attr': {'id': 'reset-password', 'class': 'grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-6'}}) }}
                            <div class="flex flex-col gap-2">
                                <label class="font-bold opacity-70 text-xs uppercase ml-1">Nouveau mot de passe</label>
                                {{ form_widget(resetPasswordForm.password.first, {'attr': {'class': 'input input-bordered focus:input-secondary bg-base-100 w-full'}}) }}
                            </div>
                            <div class="flex flex-col gap-2">
                                <label class="font-bold opacity-70 text-xs uppercase ml-1">Confirmer</label>
                                {{ form_widget(resetPasswordForm.password.second, {'attr': {'class': 'input input-bordered focus:input-secondary bg-base-100 w-full'}}) }}
                            </div>

                            <div class="col-span-full mt-4 flex items-center justify-between border-t border-base-200 pt-6">
                                <div id="result" class="text-sm font-bold italic text-secondary"></div>
                                <button type="submit" class="btn btn-secondary px-10 shadow-lg">Mettre à jour</button>
                            </div>
                            {{ form_end(resetPasswordForm) }}
                        </div>
                    </div>
                    <div class="card bg-error-content/10 shadow-xl border border-base-300">
                        <div class="card-body p-8">
                            <h3 class="text-xl font-bold mb-8 flex items-center gap-2 text-error">
                                <i class="fas fa-triangle-exclamation"></i> Suppression du compte
                            </h3>

                            <h4 class="font-bold text-base mb-2">Désactivation (Soft delete)</h4>
                            <p class="text-sm opacity-70 mb-6">
                                Votre compte sera désactivé et anonymisé, par contre vos données (Commentaires) ne seront pas supprimer. Vous pouvez indiquer une raison avant validation.
                            </p>

                            {{ form_start(softDeleteForm, {'attr': {'id': 'soft-delete', 'class': 'grid grid-cols-1 gap-x-6 gap-y-6'}}) }}
                            <div class="flex flex-col gap-2">
                                <label class="font-bold opacity-70 text-xs uppercase ml-1">Raison de la suppression partielle</label>
                                {{ form_widget(softDeleteForm.reason, {'attr': {'class': 'input input-bordered focus:input-primary bg-base-100 w-full'}}) }}
                            </div>

                            <div class="col-span-full mt-4 flex items-center justify-between border-t border-base-200 pt-6">
                                <div id="result" class="text-sm font-bold italic"></div>
                                <button type="submit" class="btn btn-error px-10 shadow-lg">Supprimer partiellement mon compte</button>
                            </div>
                            {{ form_end(softDeleteForm) }}
                        </div>
                    </div>
                    <div class="card bg-error-content/20 shadow-xl border border-base-300">
                        <div class="card-body p-8">
                            <h4 class="font-bold text-base mb-2 text-error">Suppression définitive (Hard delete)</h4>
                            <p class="text-sm opacity-70 mb-6">
                                Action irréversible : votre compte sera supprimé définitivement.
                            </p>

                            <form
                                id="hard-delete"
                                class="grid grid-cols-1 gap-y-6"
                                onsubmit="return confirm('Suppression définitive : êtes-vous absolument sûr ?');"
                            >
                                <div class="mt-2 flex items-center justify-end border-t border-base-200 pt-6">
                                    <button type="submit" class="btn btn-error px-10 shadow-lg">
                                        Supprimer définitivement
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ vite_entry_script_tags('user') }}
    {{ vite_entry_script_tags('avatar') }}
{% endblock %}
