<dialog id="login_modal" class="modal">
    <div class="modal-box max-w-md bg-base-100 border border-base-300 shadow-2xl">
        <form method="dialog">
            <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
        </form>

        <div class="text-center mb-8">
            <h3 class="font-extrabold text-3xl text-primary">Connexion</h3>
            <p class="py-2 text-sm opacity-60 italic">Heureux de vous revoir sur BlogIA</p>
        </div>

        {{ form_start(loginForm, {'attr': {'id': 'login-form', 'class': 'flex flex-col gap-4'}}) }}
        <div class="flex flex-col gap-1">
            <label class="label-text font-bold text-xs uppercase opacity-70 ml-1">Email</label>
            {{ form_widget(loginForm.email, {'attr': {'class': 'input input-bordered focus:input-primary w-full'}}) }}
        </div>
        <div class="flex flex-col gap-1">
            <label class="label-text font-bold text-xs uppercase opacity-70 ml-1">Mot de passe</label>
            {{ form_widget(loginForm.password, {'attr': {'class': 'input input-bordered focus:input-primary w-full'}}) }}
        </div>

        <div id="result" class="text-xs font-bold text-center italic mt-2"></div>

        <button type="submit" class="btn btn-primary w-full mt-4">Se connecter</button>
        {{ form_end(loginForm) }}

        <div class="text-center mt-6 text-sm">
            Pas encore de compte ?
            <button onclick="login_modal.close(); register_modal.showModal()" class="text-primary font-bold hover:underline">Inscrivez-vous</button>
        </div>
    </div>
</dialog>

{# Modale d'Inscription #}
<dialog id="register_modal" class="modal">
    <div class="modal-box max-w-md bg-base-100 border border-base-300 shadow-2xl">
        <form method="dialog">
            <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
        </form>

        <div class="text-center mb-8">
            <h3 class="font-extrabold text-3xl text-secondary">Inscription</h3>
            <p class="py-2 text-sm opacity-60 italic">Rejoignez la communauté du futur</p>
        </div>

        {{ form_start(registerForm, {'attr': {'id': 'register-form', 'class': 'flex flex-col gap-4'}}) }}
        <div class="flex flex-col gap-1">
            <label class="label-text font-bold text-xs uppercase opacity-70 ml-1">Nom d'utilisateur</label>
            {{ form_widget(registerForm.username, {'attr': {'class': 'input input-bordered focus:input-secondary w-full'}}) }}
        </div>
        <div class="flex flex-col gap-1">
            <label class="label-text font-bold text-xs uppercase opacity-70 ml-1">Email</label>
            {{ form_widget(registerForm.email, {'attr': {'class': 'input input-bordered focus:input-secondary w-full'}}) }}
        </div>
        {# Password repeated #}
        <div class="flex flex-col gap-1">
            <label class="label-text font-bold text-xs uppercase opacity-70 ml-1">Mot de passe</label>
            {{ form_widget(registerForm.password.first, {'attr': {'class': 'input input-bordered focus:input-secondary w-full'}}) }}
        </div>
        <div class="flex flex-col gap-1">
            <label class="label-text font-bold text-xs uppercase opacity-70 ml-1">Confirmer le mot de passe</label>
            {{ form_widget(registerForm.password.second, {'attr': {'class': 'input input-bordered focus:input-secondary w-full'}}) }}
        </div>

        <div id="result" class="text-xs font-bold text-center italic mt-2"></div>

        <button type="submit" class="btn btn-secondary w-full mt-4">S'inscrire</button>
        {{ form_end(registerForm) }}

        <div class="text-center mt-6 text-sm">
            Déjà inscrit ?
            <button onclick="register_modal.close(); login_modal.showModal()" class="text-secondary font-bold hover:underline">Connectez-vous</button>
        </div>
    </div>
</dialog>

{% block javascripts %}
    {{ vite_entry_script_tags('security') }}
{% endblock %}
