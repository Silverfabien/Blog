<div class="card bg-base-100 shadow-xl border border-base-300 overflow-hidden">
    <div class="h-24 bg-base-200"></div>
    <div class="px-6 pb-8 text-center">
        <div class="avatar placeholder -mt-12 mb-4">
            <div class="bg-neutral text-neutral-content rounded-2xl w-24 h-24 ring ring-base-100 ring-offset-2 shadow-2xl">
                <span class="text-3xl font-bold">{{ user.username|first|upper }}</span>
            </div>
        </div>
        <h2 id="username" class="text-2xl font-bold text-base-content">{{ user.username }}</h2>
        <p id="email" class="text-sm opacity-50 mb-6">{{ user.email }}</p>

        <div class="stats stats-vertical shadow bg-base-200 w-full">
            <div class="stat py-2">
                <div class="stat-title text-xs font-bold uppercase text-center">Commentaires</div>
                <div class="stat-value text-xl text-primary text-center">{{ user.comments|length }}</div>
            </div>
        </div>
        <div class="stat py-2 border-t border-base-300">
            <div class="stat-title text-xs font-bold uppercase">Membre depuis</div>
            <div class="stat-value text-sm">{{ user.createdAt|date('d M Y') }}</div>
        </div>
    </div>
</div>
