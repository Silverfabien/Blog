{% extends 'base.html.twig' %}

{% block title %}Hello DefaultController!{% endblock %}

{% block body %}
    {% if session.has('username') %}
        <p>Bienvenu {{ session.get('username') }}</p>
        Tu as le role {{ session.get('rolename') }}
    {% else %}
        <p>Tu n'es pas connecté</p>
    {% endif %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ vite_entry_script_tags('check_token') }}
{% endblock %}
