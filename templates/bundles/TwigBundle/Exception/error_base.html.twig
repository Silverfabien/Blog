{% extends 'base.html.twig' %}

{% block title %}Erreur {{ status_code }}{% endblock %}

{% block body %}
    <main class="bg-base-200 min-h-screen">
        <div class="hero min-h-[60vh] bg-linear-to-br from-primary to-secondary text-primary-content z-0">
            <div class="hero-overlay bg-opacity-20"></div>

            <div class="hero-content text-center text-neutral-content pt-10">
                <div class="max-w-2xl">
                    <div class="badge badge-primary badge-lg font-semibold shadow-md mb-6">
                        Erreur {{ status_code }}
                    </div>

                    <h1 class="mb-6 text-5xl md:text-9xl font-bold">
                        {{ title|default('Oups...') }}
                    </h1>

                    <p class="mb-10 text-xl font-light opacity-90">
                        {{ message|default("Une erreur est survenue.") }}
                    </p>
                </div>
            </div>
        </div>

        {# Bonus discret : uniquement si tu veux #}
        <section class="py-14">
            <div class="container mx-auto px-4 max-w-4xl">
                <div class="card bg-base-100 shadow-sm border border-base-300">
                    <div class="card-body text-center">
                        <h2 class="text-2xl font-bold mb-2">Besoin d’aide ?</h2>
                        <p class="opacity-70">
                            Si le problème persiste, tu peux nous contacter depuis la page d’accueil.
                        </p>
                    </div>
                </div>
            </div>
        </section>
    </main>
{% endblock %}
