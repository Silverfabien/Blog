<!DOCTYPE html>
<html lang="fr" data-theme="light">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}BlogIA{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
            {{ vite_entry_link_tags('app') }}
        {% endblock %}

        {% block javascripts %}
            {{ vite_entry_script_tags('app') }}
        {% endblock %}
    </head>
    <body>
        {% include 'layouts/_navbar.html.twig' %}

        {% set typeMap = {
            info: 'info',
            success: 'success',
            warn: 'warning',
            error: 'error'
        } %}
        <div id="flash-container" class="toast toast-bottom toast-end z-50">
            {% for type, messages in app.flashes %}
                {% set mappedType = typeMap[type]|default('info') %}
                {% for message in messages %}
                    <div
                        class="alert alert-{{ mappedType }} shadow-lg w-[min(420px,calc(100vw-2rem))]"
                        data-flash
                        data-timeout="5000"
                    >
                        <div class="flex items-start justify-between gap-3 w-full">
                            <span class="text-sm leading-snug">{{ message }}</span>
                            <button type="button" class="btn btn-ghost btn-xs" aria-label="Fermer">✕</button>
                        </div>
                    </div>
                {% endfor %}
            {% endfor %}
        </div>

        {{ render(controller('App\\Controller\\Security\\SecurityController::authModals')) }}
        {% block body %}{% endblock %}
        {% include 'layouts/_footer.html.twig' %}
    </body>
</html>
